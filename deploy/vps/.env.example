# Example only — real .env is generated on the VPS and never committed.
POSTGRES_DB=asambleas
POSTGRES_USER=asambleas_app
POSTGRES_PASSWORD=CHANGE_ME
ASAMBLEAS_HOST_PORT=5090
DEMO_ENABLED=true
DEMO_PUBLIC_USER_LIST=true
DEMO_PASSWORD=CHANGE_ME_STRONG_DEMO_PASSWORD
ASAMBLEAS_DEMO_PASSWORD=CHANGE_ME_STRONG_DEMO_PASSWORD
ASAMBLEAS_PUBLIC_BASE_URL=https://asambleas.164.68.99.83.nip.io
LIVEKIT_URL=wss://livekit-asambleas.164.68.99.83.nip.io
LIVEKIT_API_KEY=ASAMBLEAS_DEVKEY
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_DEFAULT_ROOM_PREFIX=assembly-
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_PORT_RANGE=7882-7892
# Twirp StartRoomCompositeEgress is served by LiveKit Server (workers via Redis).
# When LiveKit uses host networking, the app reaches it via docker host gateway.
LIVEKIT_EGRESS_URL=http://host.docker.internal:7880
# Shared output root inside egress + web containers (docker volume asambleas_recordings).
ASAMBLEAS_EGRESS_OUTPUT=/data/recordings
# Production: false = no SyntheticPilotMp4 silent fallback. Local/dev may set true.
ASAMBLEAS_RECORDING_SYNTHETIC=false

# --- External login (Google / Microsoft). Leave empty to hide buttons. ---
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
# Authentication__Microsoft__ClientId=
# Authentication__Microsoft__ClientSecret=
# Authentication__Microsoft__TenantId=common
# Optional pepper for email OTP hashes (defaults to a built-in if unset):
# ASAMBLEAS_EMAIL_OTP_PEPPER=

# --- Platform SMTP for passwordless OTP (required in Production when PH has no SMTP channel) ---
# Prefer Communications__SystemEmail__* (ASP.NET nested config). SMTP_* aliases are also read.
# Communications__SystemEmail__Host=smtp.example.com
# Communications__SystemEmail__Port=587
# Communications__SystemEmail__Username=
# Communications__SystemEmail__Password=
# Communications__SystemEmail__FromAddress=noreply@example.com
# Communications__SystemEmail__FromDisplayName=ASAMBLEAS
# Communications__SystemEmail__UseSsl=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=ASAMBLEAS
# SMTP_USE_SSL=true

# --- Workstation SSH (optional; use scripts/vps-ssh.ps1 + scripts/.env.vps) ---
# ASAMBLEAS_VPS_HOST=root@164.68.99.83
# ASAMBLEAS_VPS_PASSWORD=...
# ASAMBLEAS_VPS_HOSTKEY=ssh-ed25519 SHA256:fXnxiWr5sqazM3xRId7HtcseAZ0XHcJ2BBIuPsLt2J0
